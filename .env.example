# Palta local/mobile public configuration only.
# Copy to .env.local or the app-specific environment file as appropriate.
# NEVER put server/admin/provider private secrets in EXPO_PUBLIC_* values.

EXPO_PUBLIC_PALTA_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_ENV=development

# palta-dev public Auth configuration. Publishable keys are designed for client use.
EXPO_PUBLIC_SUPABASE_URL=https://rqbpbauhkdgsrkbwmkmg.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QEHIwvil9m4lyE6kJ1ba6w_CjA9_XXh

# Golden User 001 synthetic Auth is development/test only.
# Keep disabled in shared/default config. Enable only in a local development env.
# The synthetic password is bundled into that development build, so never enable
# these variables in production and never commit the real password.
EXPO_PUBLIC_ENABLE_GOLDEN_USER_AUTH=false
EXPO_PUBLIC_GOLDEN_USER_EMAIL=
EXPO_PUBLIC_GOLDEN_USER_PASSWORD=

# Optional public map/style endpoint when available.
EXPO_PUBLIC_MAP_STYLE_URL=

# Server-side secrets belong in Cloudflare/hosting secret stores, not here:
# SUPABASE_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY
# PAYMENT_PROVIDER_ACCESS_TOKEN
# PAYMENT_WEBHOOK_SECRET
# R2_SECRET_ACCESS_KEY
