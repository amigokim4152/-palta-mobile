# Palta local/mobile public configuration only.
# Copy to .env.local or the app-specific environment file as appropriate.
# NEVER put server/admin/provider private secrets in EXPO_PUBLIC_* values.

EXPO_PUBLIC_PALTA_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_ENV=development

# Production public endpoints:
# EXPO_PUBLIC_PALTA_API_BASE_URL=https://palta-map-edge.kimeuisin.workers.dev
# EXPO_PUBLIC_MAP_STYLE_URL=https://palta-map-edge.kimeuisin.workers.dev/maps/cl/style.json
# EXPO_PUBLIC_ENV=production

# Add only after Supabase project creation.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public map/style endpoint when available.
# When omitted, the runtime uses Palta's production map-style URL by default.
EXPO_PUBLIC_MAP_STYLE_URL=

# Server-side secrets belong in Cloudflare/hosting secret stores, not here:
# SUPABASE_SERVICE_ROLE_KEY
# PAYMENT_PROVIDER_ACCESS_TOKEN
# PAYMENT_WEBHOOK_SECRET
# R2_SECRET_ACCESS_KEY
