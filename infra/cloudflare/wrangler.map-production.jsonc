{
  "name": "palta-map-edge",
  "main": "src/index-v17.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "vars": {
    "MAP_VERSION": "2026.09.17.1",
    "MAP_OBJECT_KEY": "palta/cl/maps/basemap/versions/2026.09.17.1/basemap.pmtiles",
    "BUSINESS_OBJECT_KEY": "palta/cl/local-business/current/businesses.json",
    "LOCAL_PLACE_OBJECT_KEY": "palta/cl/local-place/current/places.json"
  },
  "r2_buckets": [
    {
      "binding": "MAPS",
      "bucket_name": "palta-data"
    }
  ]
}
