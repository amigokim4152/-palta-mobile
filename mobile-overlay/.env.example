# Native development on a physical iPhone can use the Mac on the same LAN.
# Example only: replace with the Mac's actual LAN IP.
EXPO_PUBLIC_PALTA_API_BASE_URL=http://192.168.1.20:8787
EXPO_PUBLIC_PALTA_API_KEY=
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_MAP_STYLE_URL=

# PWA/preview builds must use a public HTTPS Palta API boundary and a
# browser-safe publishable key. Never place a Supabase secret/service-role key here.
# EXPO_PUBLIC_PALTA_API_BASE_URL=https://<project>.supabase.co/functions/v1/palta-public-api
# EXPO_PUBLIC_PALTA_API_KEY=sb_publishable_...
# EXPO_PUBLIC_ENV=preview
