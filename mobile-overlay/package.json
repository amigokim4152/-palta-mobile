{
  "name": "somos-palta-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "config": "expo config --type public",
    "bundle:ios": "expo export --platform ios --output-dir .expo-export/ios",
    "verify": "npm run typecheck && npm run config && npm run bundle:ios",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.3.10",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.19",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}