{
  "version": "2.0",
  "status": "design_system_contract",
  "scope": "shared Palta product UI",
  "rules": {
    "domain_may_fork_shared_component": false,
    "domain_may_hardcode_brand_tokens": false,
    "missing_shared_component_requires_registry_entry": true,
    "official_brand_assets_only": true,
    "emoji_as_core_ui_icon": false
  },
  "primitives": [
    {"name":"PaltaText","states":["default","disabled","inverse"]},
    {"name":"PaltaIcon","states":["default","active","disabled"]},
    {"name":"PaltaSurface","states":["default","subtle","elevated","pressed"]},
    {"name":"PaltaDivider","states":["default"]},
    {"name":"PaltaButton","states":["default","pressed","loading","success","disabled","error"]},
    {"name":"PaltaIconButton","states":["default","pressed","selected","disabled"]},
    {"name":"PaltaInput","states":["idle","focused","filled","disabled","error"]},
    {"name":"PaltaAvatar","states":["default","loading","fallback","verified"]},
    {"name":"PaltaImage","states":["loading","loaded","error","placeholder"]},
    {"name":"PaltaPressable","states":["default","pressed","disabled"]}
  ],
  "components": [
    {"name":"PaltaHeader","purpose":"Compact brand/locality/screen header","states":["default","offline","notification_attention"]},
    {"name":"SearchBar","purpose":"Canonical product search control","states":["idle","focused","typing","loading","disabled"]},
    {"name":"FilterChip","purpose":"Compact filters and selections","states":["default","selected","pressed","disabled"]},
    {"name":"StatusBadge","purpose":"Compact semantic state label","states":["neutral","info","success","warning","danger","stale"]},
    {"name":"TrustStatus","purpose":"Verified/currentness/trust expression","states":["verified","unverified","pending","stale","unknown"]},
    {"name":"PrimaryAction","purpose":"Single dominant CTA","states":["default","pressed","loading","success","disabled","error"]},
    {"name":"SecondaryAction","purpose":"Supporting CTA","states":["default","pressed","loading","disabled"]},
    {"name":"ContentCard","purpose":"General content container without domain styling","states":["default","pressed","selected","disabled","stale"]},
    {"name":"ActionCard","purpose":"Context plus next action","states":["default","pressed","completed","stale","disabled"]},
    {"name":"HomeCandidateCard","purpose":"Home action/status/alert/useful/content candidate","states":["default","pressed","disabled","stale"]},
    {"name":"ListRow","purpose":"Canonical list item","states":["default","pressed","selected","disabled","stale"]},
    {"name":"EmptyState","purpose":"No-content/no-result state","states":["neutral","actionable","living_example_available"]},
    {"name":"ErrorState","purpose":"Recoverable/nonrecoverable failure state","states":["retryable","offline","permission","fatal"]},
    {"name":"Skeleton","purpose":"Loading placeholder matching final layout","states":["loading"]},
    {"name":"BottomSheet","purpose":"Context-preserving secondary surface","states":["peek","half","full","loading","empty","degraded"]},
    {"name":"Modal","purpose":"Focused interruptive task surface","states":["default","loading","error"]},
    {"name":"Toast","purpose":"Short nonblocking feedback","states":["info","success","warning","error"]},
    {"name":"ProfileHeader","purpose":"Shared person/business/organization/public/example profile identity","states":["default","verified","example","restricted"]},
    {"name":"MediaStrip","purpose":"Shared image/video attachment display","states":["loading","loaded","error"]},
    {"name":"ContextMenu","purpose":"Secondary contextual actions","states":["closed","open"]},
    {"name":"ConfirmationSheet","purpose":"Confirm consequential action","states":["default","loading","error"]},
    {"name":"NeighborhoodSearchBar","purpose":"Local search preserving locality context","states":["idle","focused","typing","loading"]},
    {"name":"MapResultSheet","purpose":"Map/list synchronized browsing sheet","states":["peek","half","full","loading","empty","degraded"]},
    {"name":"LocalResultCard","purpose":"Canonical place/business result card","states":["default","selected","pressed","stale"]},
    {"name":"CommunityPostCard","purpose":"Shared community feed post container","states":["default","pressed","moderated","hidden","blocked_author"]},
    {"name":"CommentThread","purpose":"Comment/reply hierarchy","states":["default","loading_more","collapsed","moderated"]},
    {"name":"ReactionBar","purpose":"Registered reactions and counts","states":["default","reacted","disabled"]},
    {"name":"ConversationRow","purpose":"Message/conversation list item","states":["default","unread","muted","pinned","failed"]},
    {"name":"MessageBubble","purpose":"Message content with contextual attachments","states":["sending","sent","delivered","read","failed"]},
    {"name":"TimelineItem","purpose":"Care/process/lifecycle timeline event","states":["upcoming","current","completed","overdue","blocked"]},
    {"name":"FormSection","purpose":"Progressive grouped form inputs","states":["default","complete","error","disabled"]}
  ],
  "patterns": [
    {"name":"HomeRelevantActionPattern","domains":["home"]},
    {"name":"DiscoveryPattern","domains":["local_business","market","real_estate","jobs","places"]},
    {"name":"MapSheetPattern","domains":["local_business","transport","real_estate","places"]},
    {"name":"FeedThreadPattern","domains":["community","local_news"]},
    {"name":"DetailActionPattern","domains":["all"]},
    {"name":"TimelineCarePattern","domains":["health","appointments","services","lifecycle"]},
    {"name":"ProgressiveFormPattern","domains":["all"]},
    {"name":"ConversationContextPattern","domains":["messaging","business","community","market"]}
  ]
}