{
  "version": "2.3.0",
  "bottom_tabs": [
    {
      "key": "home",
      "route": "/(tabs)/home",
      "purpose": "private life state"
    },
    {
      "key": "businesses",
      "route": "/(tabs)/businesses",
      "purpose": "full-map local business discovery, relationship and action"
    },
    {
      "key": "community",
      "route": "/(tabs)/community",
      "purpose": "groups/local conversation"
    },
    {
      "key": "market",
      "route": "/(tabs)/market",
      "purpose": "transactions/opportunities"
    },
    {
      "key": "play",
      "route": "/(tabs)/play",
      "purpose": "time/experience/travel"
    }
  ],
  "shared_routes": [
    "/search",
    "/map",
    "/place/[id]",
    "/business/[businessId]",
    "/local-businesses/following",
    "/business/register",
    "/business/manage/[businessId]",
    "/care/[careTrackId]",
    "/context/[contextId]"
  ],
  "compatibility_aliases": {
    "/local-businesses": "/(tabs)/businesses",
    "/activity/[id]": "/care/[id]"
  },
  "non_tabs": [
    "map",
    "create/post",
    "notifications",
    "profile/settings"
  ],
  "first_vertical_slice": [
    "home",
    "businesses",
    "business_detail",
    "action",
    "care_or_conversation_state",
    "home_or_businesses_return"
  ]
}
