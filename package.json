{
  "name": "palta-app-prep-v4-5",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node dist/tests/run-tests.js && node dist/tests/news-web-tests.js",
    "mock:api": "node dev/mock-api/server.mjs",
    "mock:smoke": "node dev/mock-api/smoke.mjs",
    "check:independence": "node scripts/check-core-independence.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "verify": "npm run typecheck && npm test && npm run check:independence && npm run check:design-system",
    "preflight:env": "node scripts/preflight-env.mjs",
    "preflight:local": "bash scripts/preflight-local.sh",
    "check:machine": "bash scripts/machine-readiness-check.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
